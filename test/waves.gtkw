[*]
[*] axi4_to_dfi_ddr — curated GTKWave layout for test/build/sim.vcd
[*] Groups the tb_axi4_to_dfi_bridge.v top-level AXI4 / DFI interface signals
[*] by function. Generate the VCD with `make -C test vcd`, then either
[*] `make -C test wave` (opens this layout automatically) or
[*] `gtkwave test/build/sim.vcd test/waves.gtkw` by hand.
[*]
[dumpfile] "build/sim.vcd"
[savefile] "waves.gtkw"
[timestart] 0
[size] 1600 1000
[pos] -1 -1
*-16.000000 1000 -1 0
[sst_width] 260
[signals_width] 300
[sst_expanded] 1
[sst_vpaned_height] 240
